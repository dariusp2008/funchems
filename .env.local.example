# Public — safe for browser, respects row-level security
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses RLS, never expose to client
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — comma-separated emails allowed to write via /api/admin/*
ADMIN_EMAILS=

# Resend
RESEND_API_KEY=
RESEND_FROM="Morpheps <orders@yourdomain.com>"
